# Postgres with the pgvector extension available
DATABASE_URL=postgresql://user:password@localhost:5432/fhir_bridge

# Kyma API (https://kymaapi.com) — used for LLM inference (intent/synthesis)
# and the chat-model catalog (frontend model dropdown). No longer used for KB
# embeddings, see OPENAI_API_KEY below.
# Confirm the correct API host against your Kyma dashboard/docs before relying
# on this default: docs disagree between kymaapi.com/v1 and api.kymaapi.com/v1.
KYMA_API_KEY=
KYMA_EMBEDDINGS_BASE_URL=https://api.kymaapi.com/v1
KYMA_MESSAGES_BASE_URL=https://kymaapi.com
KYMA_INTENT_MODEL=claude-sonnet-5
KYMA_SYNTH_MODEL=claude-sonnet-5

# OpenAI API (https://platform.openai.com) — used directly for KB embeddings
# (query-time retrieval in backend/retrieval.py, and ingestion). Changing
# OPENAI_EMBEDDING_MODEL requires re-ingesting the KB and updating the
# VECTOR(...) column width in ingestion/pipeline/store.py to match its
# output dimension.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

INGEST_DATA_DIR=./data

# If you're behind a corporate TLS-inspection proxy (e.g. Zscaler), outbound
# HTTPS calls (OpenAI, Langfuse, etc) will fail with SSLCertVerificationError
# even though curl works, because curl uses the OS trust store and Python's
# certifi bundle doesn't include your proxy's CA. Fix: build a bundle with
# your proxy's root CA appended to certifi's, and point these at it (leave
# blank otherwise):
#   security find-certificate -a -c "<YourProxy>" -p /Library/Keychains/System.keychain > /tmp/proxy-ca.pem
#   cat .venv/lib/python3.11/site-packages/certifi/cacert.pem /tmp/proxy-ca.pem > certs/local-ca-bundle.pem
# Don't reach for pip-system-certs/truststore instead -- it monkeypatches
# ssl.SSLContext in a way that recurses infinitely against some SDKs' HTTP
# clients.
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# Langfuse (https://www.langfuse.com) — per-turn LLM/agent tracing: prompts,
# token usage, latency, per-node graph execution (see
# backend/langfuse_setup.py). Create a free Langfuse Cloud project and copy
# its keys here. Leave all blank to disable tracing entirely (the SDK
# no-ops safely, e.g. in CI).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# "local" here, "production" on Railway -- purely a label so traces from
# each environment are easy to tell apart in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=local

# Quality-report email notification. Leave NOTIFY_EMAIL_PROVIDER unset to
# just log instead of sending (safe default -- no credentials required).
NOTIFY_TO_EMAIL=huy.trinhx@gmail.com
NOTIFY_EMAIL_PROVIDER=
# Resend (https://resend.com) -- only used when NOTIFY_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Default sender only delivers to the email your Resend account was signed
# up with, unless you verify your own sending domain.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# Session tokens (auth.py) -- required for signup/login/Google OAuth to work.
# Any long random string; changing it invalidates all issued tokens.
SECRET_KEY=

# Google OAuth (https://console.cloud.google.com) -- create an OAuth client,
# register this exact redirect URI, then fill in the two values below.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin the frontend is served from -- used for CORS and as the target of
# the Google OAuth redirect. In production (single Railway service, see root
# Dockerfile) this is the app's own public URL, e.g.
# https://fhir-bridge.up.railway.app -- and GOOGLE_REDIRECT_URI above should
# be that same host + /api/auth/google/callback.
FRONTEND_ORIGIN=http://localhost:5173

# Railway sets PORT itself; only set this manually for local Docker testing.
PORT=8000
