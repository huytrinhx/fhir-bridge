# Postgres with the pgvector extension available
DATABASE_URL=postgresql://user:password@localhost:5432/fhir_bridge

# Kyma API (https://kymaapi.com) — used for embedding and inference
# Confirm the correct API host against your Kyma dashboard/docs before relying
# on this default: docs disagree between kymaapi.com/v1 and api.kymaapi.com/v1.
KYMA_API_KEY=
KYMA_EMBEDDINGS_BASE_URL=https://api.kymaapi.com/v1
KYMA_EMBEDDING_MODEL=qwen3-embedding-8b
KYMA_MESSAGES_BASE_URL=https://kymaapi.com
KYMA_INTENT_MODEL=claude-sonnet-5
KYMA_SYNTH_MODEL=claude-sonnet-5

INGEST_DATA_DIR=./data

# Quality-report email notification. Leave NOTIFY_EMAIL_PROVIDER unset to
# just log instead of sending (safe default -- no credentials required).
NOTIFY_TO_EMAIL=huy.trinhx@gmail.com
NOTIFY_EMAIL_PROVIDER=
# Resend (https://resend.com) -- only used when NOTIFY_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Default sender only delivers to the email your Resend account was signed
# up with, unless you verify your own sending domain.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# Session tokens (auth.py) -- required for signup/login/Google OAuth to work.
# Any long random string; changing it invalidates all issued tokens.
SECRET_KEY=

# Google OAuth (https://console.cloud.google.com) -- create an OAuth client,
# register this exact redirect URI, then fill in the two values below.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
